# Copy to .env and edit. Real environment variables override this file.

# Where you are (required)
HOME_LAT=53.9167
HOME_LON=-1.7568

# Aircraft feed. Leave unset to use the public adsb.lol feed around HOME_LAT/HOME_LON.
# Or point at your own receiver Pi:
# AIRCRAFT_URL=http://192.168.1.50/tar1090/data/aircraft.json

# RADIUS_KM=25
# MIN_ALTITUDE_FT=500
# POLL_SECONDS=20
# NIGHT_START=23
# NIGHT_END=7
# LOGO_THRESHOLD=128
# SHOW_PHOTOS=0   # turn off the aircraft photo
